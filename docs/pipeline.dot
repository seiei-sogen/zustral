// The stages of lib/Compiler.ml and their types in lib/Pipeline.mli.
// Boxes are values, ellipses are stages (named by the function that runs them).
// A dashed edge is the environment or the supply that a stage reads or returns.
digraph G {
    node[style=filled]

    aui[shape=rect fillcolor=coral label=".aui (module_source)"]
    aum[shape=rect fillcolor=coral label=".aum (module_source)"]

    subgraph cluster_module {
        label="compile_mod: once per module"

        icst[shape=rect fillcolor=coral1 label="concrete_module_interface (Cst)"]
        bcst[shape=rect fillcolor=coral1 label="concrete_module_body (Cst)"]
        combined[shape=rect fillcolor=aquamarine label="Combined.combined_module (Ast)"]
        returning[shape=rect fillcolor=aquamarine label="ReturnCheck.returning_module"]
        small[shape=rect fillcolor=aquamarine3 label="SmallCombined.combined_module (AstDB)"]
        linked[shape=rect fillcolor=aquamarine4 label="Linked.linked_module"]
        typed[shape=rect fillcolor=chartreuse1 label="Tast.typed_module"]
        checked[shape=rect fillcolor=chartreuse3 label="LinearityCheck.checked_module"]
        mono[shape=rect fillcolor=firebrick2 label="Mtast.mono_module"]
        unit[shape=rect fillcolor=coral label="c_unit"]

        parse_int[label="parse_module_int"]
        parse_body[label="parse_module_body"]
        combine[label="combine / body_as_combined"]
        check_returns[label="check_ends_in_return"]
        desugar[label="desugar"]
        extract[label="extract"]
        augment[label="augment_module"]
        linearity[label="check_module_linearity"]
        bodies[label="extract_bodies"]
        monomorphize[label="monomorphize"]
        gen[label="gen_module"]
    }

    subgraph cluster_finish {
        label="finish: once, after all modules"

        wrappers[label="monomorphize_wrappers, gen_module, all_wrappers"]
        entry[label="entrypoint_code"]
        program[shape=rect fillcolor=coral label="c_program"]
    }

    render[label="render_program (cli/)"]
    c[shape=rect fillcolor=coral label="C code"]

    env[label="env" fillcolor=forestgreen shape=cylinder]
    supply[label="Supply.t (in env)" fillcolor=palegreen shape=cylinder]

    aui -> parse_int -> icst -> combine
    aum -> parse_body -> bcst -> combine
    combine -> combined -> check_returns -> returning -> desugar -> small -> extract -> linked
    linked -> augment -> typed -> linearity -> checked
    checked -> bodies
    checked -> monomorphize -> mono -> gen -> unit
    unit -> program
    wrappers -> program
    entry -> program
    program -> render -> c

    edge[style=dashed]
    env -> combine
    env -> extract
    extract -> env
    env -> augment
    env -> bodies
    bodies -> env
    env -> monomorphize
    monomorphize -> env
    env -> gen
    env -> wrappers
    wrappers -> env
    env -> entry
    supply -> wrappers
    wrappers -> supply
    supply -> desugar
    desugar -> supply
    supply -> augment
    augment -> supply
    supply -> gen
    gen -> supply
}
