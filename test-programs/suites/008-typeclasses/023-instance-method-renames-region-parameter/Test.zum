module body Test is
    typeclass Describe(T: Free) is
        generic [R: Region]
        method describe(value: &[T, R]): Unit;
    end;

    instance Describe(Int32) is
        generic [S: Region]
        method describe(value: &[Int32, S]): Unit is
            printLn(!value);
            return nil;
        end;
    end;

    function main(): ExitCode is
        let n: Int32 := 7;
        describe(&n);
        return ExitSuccess();
    end;
end module body.
