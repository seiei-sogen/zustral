module body Test is
    function next(x: Int32): Int32 is
        return x + 1;
    end;

    function callWithLiteral(f: Fn[Int32, Int32]): Int32 is
        let r: Int32 := f(41);
        return r;
    end;

    function sameSize(x: ByteSize): ByteSize is
        return x;
    end;

    function callWithSize(f: Fn[ByteSize, ByteSize]): ByteSize is
        let r: ByteSize := f(sizeof(Int32));
        return r;
    end;

    generic [T: Free]
    function callWithValue(f: Fn[T, T], x: T): T is
        let r: T := f(x);
        return r;
    end;

    function main(): ExitCode is
        let n: Int32 := callWithLiteral(next);
        printLn(n);
        let s: ByteSize := callWithSize(sameSize);
        printLn(s);
        printLn(callWithValue(next, 1));
        return ExitSuccess();
    end;
end module body.
