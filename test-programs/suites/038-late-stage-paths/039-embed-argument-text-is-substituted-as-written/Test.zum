pragma Unsafe_Module;

module body Test is
    function main(): ExitCode is
        let one: Nat8 := @embed(Nat8, "$1", @embed(Nat8, "'\1'"));
        printLn(one);
        let backslash: Nat8 := @embed(Nat8, "$1", @embed(Nat8, "'\\'"));
        printLn(backslash);
        let size: Index := @embed(Index, "$1", @embed(Index, "sizeof(\"$2\")"), @embed(Nat8, "7"));
        printLn(size);
        let kept: Index := @embed(Index, "sizeof(\"$2\")", @embed(Nat8, "7"));
        printLn(kept);
        return ExitSuccess();
    end;
end module body.
