module body Test is
    union Choice[R: Region]: Free is
        case Some is
            r: R;
        case Nothing;
    end;

    typeclass Shape(T: Type) is
        generic [R: Region]
        method area(x: T, y: Choice[R]): Int32;
    end;

    instance Shape(Int32) is
        generic [R: Region]
        method area(x: Int32, y: Choice[R]): Int32 is
            return x;
        end;
    end;

    function main(): ExitCode is
        printLn("ok");
        return ExitSuccess();
    end;
end module body.
