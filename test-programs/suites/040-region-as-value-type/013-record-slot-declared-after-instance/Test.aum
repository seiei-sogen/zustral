module body Test is
    typeclass Shape(T: Type) is
        generic [R: Region]
        method area(x: T, y: Outer[R]): Int32;
    end;

    instance Shape(Int32) is
        generic [R: Region]
        method area(x: Int32, y: Outer[R]): Int32 is
            return x;
        end;
    end;

    record Outer[R: Region]: Free is
        b: Box[R];
    end;

    record Box[R: Region]: Free is
        r: R;
    end;

    function main(): ExitCode is
        printLn("ok");
        return ExitSuccess();
    end;
end module body.
