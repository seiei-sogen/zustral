module body Test is
    function main(): ExitCode is
        let a: Int8 := 127;
        printLn(-a);
        let b: Int16 := -32767;
        printLn(-b);
        let c: Int32 := 5;
        printLn(-c);
        let d: Int64 := 9223372036854775807;
        printLn(-d);
        let e: Int32 := -(c + 1);
        printLn(e);
        let f: Int32 := c * -c;
        printLn(f);
        printLn(2 * -c);
        return ExitSuccess();
    end;
end module body.
