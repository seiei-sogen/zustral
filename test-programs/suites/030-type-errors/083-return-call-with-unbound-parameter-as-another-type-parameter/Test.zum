module body Test is
    union Choice[A: Free, B: Free]: Free is
        case First is
            left: A;
        case Second is
            right: B;
    end;

    generic [A: Free, B: Free]
    function leftOnly(a: A): Choice[A, B] is
        return First(left => a);
    end;

    generic [T: Free, U: Free, V: Free]
    function confused(x: T, y: U, z: V): Choice[T, V] is
        return leftOnly(y);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
