module body Test is
    union Either[A: Free, B: Free]: Free is
        case Left is
            left: A;
        case Right is
            right: B;
    end;

    generic [A: Free, B: Free]
    function leftOnly(a: A): Either[A, B] is
        return Left(left => a);
    end;

    generic [T: Free, U: Free, V: Free]
    function confused(x: T, y: U, z: V): Either[T, V] is
        return leftOnly(y);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
