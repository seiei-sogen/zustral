module body Test is
    union Choice[A: Free, B: Free]: Free is
        case First is
            left: A;
        case Second is
            right: B;
    end;

    generic [A: Free, B: Free]
    function leftOnly(a: A): Choice[A, B] is
        return First(left => a);
    end;

    generic [T: Free, V: Free]
    function leftOf(x: T, z: V): Choice[T, V] is
        return leftOnly(x);
    end;

    function main(): ExitCode is
        let e: Choice[Int32, Bool] := leftOf(7, true);
        case e of
            when First(left: Int32) do
                printLn(left);
            when Second(right: Bool) do
                printLn(right);
        end case;
        return ExitSuccess();
    end;
end module body.
