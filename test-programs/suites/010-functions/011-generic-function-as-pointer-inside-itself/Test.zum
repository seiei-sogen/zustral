module body Test is
    generic [T: Free]
    function firstSome(a: Option[T], b: Option[T]): Option[T] is
        case a of
            when Some(value: T) do
                return Some(value => value);
            when None do
                let itself: Fn[Option[T], Option[T], Option[T]] := firstSome;
                return itself(b, b);
        end case;
    end;

    function main(): ExitCode is
        let none: Option[Int32] := None();
        let seven: Option[Int32] := Some(value => 7);
        case firstSome(none, seven) of
            when Some(value: Int32) do
                printLn(value);
            when None do
                printLn("none");
        end case;
        return ExitSuccess();
    end;
end module body.
