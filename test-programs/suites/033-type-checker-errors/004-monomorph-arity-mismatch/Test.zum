module body Test is
    typeclass TC(T: Free) is
        method accept(x: T): Int32;
    end;

    generic [A: Free]
    instance TC(Int32) is
        method accept(x: Int32): Int32 is
            return x;
        end;
    end;

    function main(): ExitCode is
        printLn(accept(42));
        return ExitSuccess();
    end;
end module body.
