pragma Unsafe_Module;

import Austral.Memory (Address, Pointer);

module body Test is
    record Tag: Free is
        x: Int32;
    end;

    record Lin: Linear is
        x: Int32;
    end;

    generic [T: Linear]
    function callee(p: Pointer[T]): Unit is
        return nil;
    end;

    function caller(p: Pointer[Int32]): Unit is
        callee(p);
        return nil;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
