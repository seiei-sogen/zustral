pragma Unsafe_Module;

import Austral.Memory (Address, Pointer);

module body Test is
    record Tag: Free is
        x: Int32;
    end;

    record Lin: Linear is
        x: Int32;
    end;

    function take(f: Fn[Int32]): Unit is
        return nil;
    end;

    function pass(f: Fn[Int32, Int32]): Unit is
        take(f);
        return nil;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
