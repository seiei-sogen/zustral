module body Test is
    function decrement(n: Int64): Int64 is
        return n - 1;
    end;

    function main(): ExitCode is
        let a: Int64 := 3;
        printLn(a+5);
        printLn(a -1);
        printLn(a-1);
        printLn(a - -1);
        printLn(-a + 10);
        printLn(decrement(-1));
        var x: Int64 := 0;
        x := -5;
        printLn(x);
        let b: Int8 := -128;
        printLn(b);
        let c: Int64 := -9223372036854775808;
        printLn(c);
        let f: Float64 := 1.5;
        printLn(f+2.5);
        printLn(f -0.5);
        return ExitSuccess();
    end;
end module body.
