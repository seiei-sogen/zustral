module body Test is
    record Wide: Free is
        value: Int64;
    end;

    function widen(x: Int64): Int64 is
        return x;
    end;

    function big(): Int64 is
        return 4294967296;
    end;

    function main(): ExitCode is
        printLn(2147483647);
        printLn(-2147483648);
        printLn(#x7FFFFFFF);
        printLn(if true then 2147483647 else -2147483648);
        printLn((4294967296 : Int64));
        let a: Int64 := 4294967296;
        printLn(a);
        printLn(widen(4294967297));
        let w: Wide := Wide(value => 4294967298);
        printLn(w.value);
        printLn(big());
        var v: Int64 := 0;
        v := 4294967299;
        printLn(v);
        printLn(a + 4294967296);
        printLn(4294967296 + a);
        if a < 4294967297 then
            printLn("less");
        end if;
        if 4294967297 > a then
            printLn("greater");
        end if;
        let n: Nat64 := 18446744073709551615;
        printLn(n);
        let o: Option[Int64] := Some(value => (4294967300 : Int64));
        case o of
            when Some(value: Int64) do
                printLn(value);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
