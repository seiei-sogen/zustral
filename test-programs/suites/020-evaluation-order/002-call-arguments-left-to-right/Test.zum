module body Test is
    function p(x: Int64): Int64 is
        printLn(x);
        return x;
    end;

    function add3(a: Int64, b: Int64, c: Int64): Int64 is
        return (a + b) + c;
    end;

    function main(): ExitCode is
        let x: Int64 := add3(p(1), p(2), p(3));
        printLn(x);
        return ExitSuccess();
    end;
end module body.
