module body Test is
    function p(x: Int64): Int64 is
        printLn(x);
        return x;
    end;

    function minus(a: Int64, b: Int64): Int64 is
        return a - b;
    end;

    function main(): ExitCode is
        let f: Fn[Int64, Int64, Int64] := minus;
        printLn(f(p(5), p(3)));
        return ExitSuccess();
    end;
end module body.
