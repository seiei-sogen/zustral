module body Test is
    typeclass One(T: Free) is
        method one(x: T): Int64;
    end;

    instance One(Int32) is
        method one(x: Bool, y: Nat8): Int64 is
            return 1;
        end;
    end;

    function main(): ExitCode is
        let n: Int32 := 0;
        printLn(one(n));
        return ExitSuccess();
    end;
end module body.
