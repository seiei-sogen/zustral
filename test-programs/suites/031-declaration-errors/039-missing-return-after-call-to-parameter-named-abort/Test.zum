module body Test is
    function quiet(x: Int32): Unit is
        return nil;
    end;

    function f(abort: Fn[Int32, Unit], c: Bool): Int32 is
        if c then
            return 1;
        end if;
        abort(7);
    end;

    function main(): ExitCode is
        printLn(f(quiet, false));
        return ExitSuccess();
    end;
end module body.
