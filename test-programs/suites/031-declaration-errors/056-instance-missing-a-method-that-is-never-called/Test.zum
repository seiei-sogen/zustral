module body Test is
    typeclass Two(T: Free) is
        method one(x: T): Int64;
        method two(x: T): Int64;
    end;

    instance Two(Int32) is
        method one(x: Int32): Int64 is
            return 1;
        end;
    end;

    function main(): ExitCode is
        let n: Int32 := 0;
        printLn(one(n));
        return ExitSuccess();
    end;
end module body.
