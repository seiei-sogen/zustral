module body Test is
    record Foo: Free is
    end;

    record Box[T: Free]: Free is
        value: T;
    end;

    typeclass Outer(T: Free) is
        method outer(value: T): Int32;
    end;

    generic [U: Free(Foo)]
    instance Outer(Box[U]) is
        method outer(value: Box[U]): Int32 is
            return 2;
        end;
    end;

    function main(): ExitCode is
        let b: Box[Int32] := Box(value => 10);
        printLn(outer(b));
        return ExitSuccess();
    end;
end module body.
