module body Test is
    typeclass Kind(T: Type) is
        method kind(value: T): Int32;
    end;

    generic [A: Type, B: Type]
    instance Kind(Fn[A, B]) is
        method kind(value: Fn[A, B]): Int32 is
            return 1;
        end;
    end;

    generic [C: Type]
    instance Kind(Fn[C]) is
        method kind(value: Fn[C]): Int32 is
            return 0;
        end;
    end;

    function seven(): Int32 is
        return 7;
    end;

    function inc(x: Int32): Int32 is
        return x + 1;
    end;

    function main(): ExitCode is
        let f: Fn[Int32] := seven;
        let g: Fn[Int32, Int32] := inc;
        printLn(kind(f));
        printLn(kind(g));
        return ExitSuccess();
    end;
end module body.
