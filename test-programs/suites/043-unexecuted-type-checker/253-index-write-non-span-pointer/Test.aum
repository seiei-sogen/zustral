pragma Unsafe_Module;

import Austral.Memory (Address, Pointer);

module body Test is
    function probe(x: Pointer[Int32]): Unit is
        var y: Pointer[Int32] := x;
        y[0] := 1;
        return nil;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
