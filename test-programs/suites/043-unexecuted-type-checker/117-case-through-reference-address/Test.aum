pragma Unsafe_Module;

import Austral.Memory (Address, Pointer);

module body Test is
    generic [R: Region]
    function probe(x: &[Address[Int32], R]): Unit is
        case x of
            when A do
                skip;
        end case;
        return nil;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
