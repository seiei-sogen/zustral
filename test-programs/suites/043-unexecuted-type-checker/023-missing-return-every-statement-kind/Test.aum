module body Test is
    record Foo: Free is
        a: Int32;
    end;

    union Choice: Free is
        case C01;
        case C02;
        case C03;
        case C04;
        case C05;
        case C06;
        case C07;
        case C08;
        case C09;
        case C10;
        case C11;
        case C12;
        case C13;
        case C14;
        case C15;
        case C16;
        case C17;
        case C18;
        case C19;
        case C20;
        case C21;
        case C22;
        case C23;
        case C24;
        case C25;
    end;

    generic [R: Region]
    function f(c: Choice, x: Int32, b: Bool, n: Foo, r: &[Int32, R], w: &![Int32, R]): Int32 is
        var v: Int32 := 0;
        case c of
            when C01 do
                nil;
            when C02 do
                true;
            when C03 do
                1;
            when C04 do
                1.0;
            when C05 do
                "text";
            when C06 do
                x;
            when C07 do
                x + 1;
            when C08 do
                x < 1;
            when C09 do
                b and b;
            when C10 do
                b or b;
            when C11 do
                not b;
            when C12 do
                if b then 1 else 2;
            when C13 do
                n.a;
            when C14 do
                &(n.a);
            when C15 do
                @embed(Int32, "1");
            when C16 do
                !r;
            when C17 do
                (x : Int32);
            when C18 do
                sizeof(Int32);
            when C19 do
                &x;
            when C20 do
                &~w;
            when C21 do
                v := 1;
            when C22 do
                if b then
                    return 1;
                end if;
            when C23 do
                while b do
                    return 2;
                end while;
            when C24 do
                for i from 0 to 1 do
                    return 3;
                end for;
            when C25 do
                borrow q: &[Int32, Q] := &v do
                    return 4;
                end borrow;
        end case;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
