module body Test is
    generic [T: Free]
    function nothing(): Option[T] is
        return None();
    end;

    function show(x: Option[Int32]): Unit is
        case x of
            when Some(value: Int32) do
                printLn(value);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        show(nothing(): Option[Int32]);
        return ExitSuccess();
    end;
end module body.
