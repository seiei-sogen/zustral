module body Test is
    record R: Linear is
        x: Int32;
    end;

    union U: Free is
        case A;
        case B;
        case C;
        case D;
    end;

    function consume(r: R): Unit is
        let { x: Int32 } := r;
        printLn(x);
        return nil;
    end;

    function main(): ExitCode is
        let r: R := R(x => 32);
        let u: U := A();
        case u of
            when A do
                skip;
            when B do
                skip;
            when C do
                consume(r);
            when D do
                consume(r);
        end case;
        return ExitSuccess();
    end;
end module body.
