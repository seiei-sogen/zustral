module body Test is
    generic [R: Region]
    function f(x: &[Int32, R]): Int32 is
        let n: Int32 := 5;
        borrow r: &[Int32, R] := &n do
            printLn(!r);
        end borrow;
        return !x;
    end;

    function main(): ExitCode is
        let n: Int32 := 1;
        printLn(f(&n));
        return ExitSuccess();
    end;
end module body.
