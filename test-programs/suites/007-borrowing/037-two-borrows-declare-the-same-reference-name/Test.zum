module body Test is
    record R: Linear is
        x: Int32;
    end;

    function main(): ExitCode is
        let r: R := R(x => 1);
        borrow rr: &[R, rho] := &r do
            printLn(rr->x);
        end borrow;
        borrow rr: &[R, rho2] := &r do
            printLn(rr->x);
        end borrow;
        let { x: Int32 } := r;
        return ExitSuccess();
    end;
end module body.
