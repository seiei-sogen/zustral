module body Test is
    record Foo: Linear is
        x: Int32;
    end;

    function main(): ExitCode is
        var foo: Foo := Foo(x => 1);
        borrow a: &[Foo, R] := &foo do
            borrow b: &[Foo, S] := &foo do
                skip;
            end borrow;
            borrow w: &![Foo, T] := &!foo do
                printLn(w->x);
            end borrow;
            printLn(a->x);
        end borrow;
        let { x: Int32 } := foo;
        return ExitSuccess();
    end;
end module body.
