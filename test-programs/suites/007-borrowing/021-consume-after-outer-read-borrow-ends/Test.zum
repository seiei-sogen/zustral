module body Test is
    record Foo: Linear is
        x: Int32;
    end;

    function main(): ExitCode is
        let foo: Foo := Foo(x => 1);
        borrow a: &[Foo, R] := &foo do
            borrow b: &[Foo, S] := &foo do
                printLn(b->x);
            end borrow;
            borrow c: &[Foo, T] := &foo do
                printLn(c->x);
            end borrow;
            printLn(a->x);
        end borrow;
        let { x: Int32 } := foo;
        printLn(x);
        return ExitSuccess();
    end;
end module body.
