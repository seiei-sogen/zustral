module body Test is
    record Foo: Linear is
        x: Int32;
    end;

    function main(): ExitCode is
        let foo: Foo := Foo(x => 1);
        borrow a: &[Foo, R] := &foo do
            borrow b: &[Foo, S] := &foo do
                skip;
            end borrow;
            let { x: Int32 } := foo;
            printLn(x);
        end borrow;
        let { x as y: Int32 } := foo;
        printLn(y);
        return ExitSuccess();
    end;
end module body.
