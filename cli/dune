(library
 (name zustral_cli)
 (public_name zustral.zustral_cli)
 (synopsis "The command line of the Zustral compiler: files, processes and exit codes.")
 (libraries zustral_core unix yojson)
 (foreign_stubs (language c) (names system_signal_number))
 (instrumentation (backend bisect_ppx))
 (preprocess (pps ppx_deriving.eq ppx_deriving.show))
 (flags
  ; A catch-all arm over a variant type (warning 4) is an error, as in lib/.
  (:standard -w @4)))
