{
  "name": "zustral",
  "displayName": "zustral",
  "description": "Zustral language support for VS Code",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/austral/austral",
    "directory": "editor/vscode-zustral"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zustral",
        "aliases": [
          "Zustral",
          "zustral"
        ],
        "extensions": [
          ".zum",
          ".zui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zustral",
        "scopeName": "source.zustral",
        "path": "./syntaxes/zustral.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zustral",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "@vscode/vsce": "^2.23.0",
    "ts-node": "^10.9.1"
  },
  "scripts": {
    "build": "vsce package",
    "syntax": "ts-node src/generate-syntaxes.ts"
  }
}
